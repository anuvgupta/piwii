# Copy to server/.env on the server host (gitignored, chmod 600).
# Login for every page and API. With either unset, the web server refuses all requests.
PIWII_USERNAME=
PIWII_PASSWORD=
# Domains piwii is served under (comma-separated): for each, the page is at
# wii.<domain> from the internet and wii.lan.<domain> on the home network
# (uploads go there when reachable; one login covers both). Leave empty to use
# piwii only on whatever host you reach it at.
PIWII_DOMAIN=
# Example: PIWII_DOMAIN=example.com -> wii.example.com and wii.lan.example.com
# Example: PIWII_DOMAIN=example.com,example.net -> the same for both

# API tokens for service accounts, such as a program that fulfils requests:
# name:token, comma-separated, one per service. A token is sent as
# "Authorization: Bearer <token>" and only opens the request-fulfilling API
# (see docs/requests-api.md). Make one with: openssl rand -hex 32
PIWII_API_TOKENS=
# Example: PIWII_API_TOKENS=fulfiller:3f9a...,otherbot:77c1...

# Optional overrides (defaults shown). Rarely needed:
# Origins allowed to call the API cross-origin (comma-separated); default
# https://wii.<domain>,https://wii.lan.<domain> for each PIWII_DOMAIN, none without one.
#PIWII_CORS_ORIGINS=https://wii.example.com,https://wii.lan.example.com
# Domains the login cookie is shared across (comma-separated; the one the
# request came in under is used); default PIWII_DOMAIN.
#PIWII_COOKIE_DOMAIN=example.com

# --- Only if the server host runs Unraid: read on the host by
# server/host/piwii-staging-mount.sh, not by the container. The Pi's NFS
# export, written exactly like the Unassigned Devices remote share entry
# (host:path).
PIWII_UD_DEVICE=
# Example: PIWII_UD_DEVICE=192.168.1.50:/srv/piwii/staging (any address; this
# setup's Pi is 192.168.4.61)
